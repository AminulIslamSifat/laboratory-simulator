# ── dependencies ──
node_modules/

# ── build output ──
# dist/ is a build artefact, rebuilt by `npm run build` and by the Render
# build step. Committing it only invites stale-file bugs.
dist/

# ── editor / tooling scratch ──
.editor_tools_backups/
*.bak
*.before_*
*.orig
*.rej

# ── logs & OS noise ──
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ── local env ──
.env
.env.*
!.env.example

# ── Render local dev ──
# `render.yaml` IS tracked (it is the deploy blueprint). Only local overrides
# and the pull-request preview state are ignored.
.render-local/
