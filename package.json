{
  "name": "eee-sim",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "EEE-2152 Electrical Machines Laboratory — interactive bench simulator with a live MNA solver",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "check": "npm run check:shafts",
    "check:shafts": "node tools/check-shafts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide": "^0.400.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.0"
  }
}
